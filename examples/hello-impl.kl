struct Planet {
    name Str
    radius Int
}

impl Planet {
    fn print_planet(self, greetings Str) {
        print(self.name)
        print(greetings)
    }

    fn diameter(self) Int {
        self.radius + self.radius
    }

    fn return_self(self) Self {
        self
    }
}

fn main() {
    let p = Planet(name="Earth", radius=6750)
    p.print_planet(" - nice to be on you!")
    print_int(p.diameter())
    p.return_self().return_self().print_planet(" - again?")
}
