fn main() {
    print_int(31 + 11)
    print(", ")
    print_int(10 + 20 + 12)
    print(", ")
    print_int(2 + 4 * 10)
    print(", ")
    print_int(4 * 5 + 2 * 5 + 2 * 5 + 4 - 2)
    print(", ")
    print_int(10 / 2)
    print(", ")
    print_int(-42 / 3)
    print(", ")
    let a U16 = 800
    print_int(a / 200)
    print(", ")
    print_int(-10 % 3)
    print(", ")
    print_int(a % 300)
}
