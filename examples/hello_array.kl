-- expect.stdout {
-- 2.42.3.3, true.false, b.Boo, 2.b.Boo
-- } expect.stdout
-- expect.exit_code: 0

fn main() {
    mut int_arr = [1, 2, 3]
    print_int(int_arr[1])
    print(".")
    int_arr[1] = 42
    print_int(int_arr[-2])
    print(".")
    print_int(int_arr.len())
    print(".")
    print_int(int_arr.capacity())
    print(", ")
    mut bool_arr = [true, false, true]
    print_bool(bool_arr[2])
    print(".")
    bool_arr[2] = false
    print_bool(bool_arr[2])
    print(", ")
    mut str_arr = ["a", "b", "c"]
    print(str_arr[1])
    print(".")
    str_arr[1] = "Boo"
    print(str_arr[1])
    print(", ")
    mut tuple_arr = [(1, "a"), (2, "b"), (3, "c")]
    print_int(tuple_arr[1].0)
    print(".")
    print(tuple_arr[1].1)
    print(".")
    tuple_arr[1] = (42, "Boo")
    print(tuple_arr[1].1)
}
