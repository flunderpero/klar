fn main() {
    let int_arr = [1, 2, 3]
    print_int(int_arr[1])
    print(".")
    print_int(int_arr.get(1))
    print(".")
    print_int(int_arr.len())
    print(".")
    print_int(int_arr.capacity())
    print(", ")
    let bool_arr = [true, false, true]
    print_bool(bool_arr[2])
    print(".")
    print_bool(bool_arr.get(2))
    print(", ")
    let str_arr = ["a", "b", "c"]
    print(str_arr[1])
    print(".")
    print(str_arr.get(1))
    print(", ")
    let tuple_arr = [(1, "a"), (2, "b"), (3, "c")]
    print_int(tuple_arr[1].0)
    print(".")
    print(tuple_arr[1].1)
    print(".")
    print(tuple_arr.get(1).1)
}
