-- expect.stdout {
-- 16, 128, 0, 63, 1, 0, 96, 3, 128, 24
-- } expect.stdout
-- expect.exit_code: 0

fn main() {
    mut x U8 = 1
    print_int(x << 4)
    print(", ")
    print_int(x << 7)
    print(", ")
    print_int(x << 8) -- Shifting beyond the number of bits in U8 will result in 0.
    print(", ")
    x = 127
    print_int(x >> 1)
    print(", ")
    print_int(x >> 6)
    print(", ")
    print_int(x >> 7)
    print(", ")
    print_int(32 | 64)
    print(", ")
    print_int(31 & 3)
    print(", ")
    print_int(~x)
    print(", ")
    print_int(31 ^ 7)
}
