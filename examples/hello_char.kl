-- c99	A
-- truetruefalse
-- } expect.stdout
-- expect.exit_code: 0

fn main() {
    let c = 'c'
    c.print_me()
    print_int(c.to_u32())
    print_char('\t')
    print_char('\u{41}')
    print_char('\n')
    print_bool('a' == 'a')
    print_bool('a' < 'b')
    print_bool('a' > 'b')
}

impl Char {
    fn print_me(self) => print_char(self)
}
