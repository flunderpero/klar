-- expect.stdout {
-- OK: true then, OK: false else, OK: 2 > 1, OK: 2 >= 2, OK: 2 == 2, OK: 1 != 2, OK: 1 < 2, OK: 1 <= 2, OK: 1 == 2 or 2 == 2, OK: 1 == 1 and 2 == 2, OK: not false, OK: nested, PASS: nested_if_result(true), PASS: nested_if_result(false)
-- } expect.stdout
-- expect.exit_code: 0

fn nested_if_result(cond Bool) Str {
    if cond { 
        if not cond => "FAIL: nested_if_result" else => "PASS: nested_if_result(true)"
    } else {
        mut x = ""
        if cond => x = "FAIL: nested_if_result" else {
            x = if 1 == 2 => "FAIL: nested_if_result" else => "PASS: nested_if_result(false)"
            x
        } 
        x
    }
}

fn main() {
    if true => print("OK: true then, ")
    if false {
        panic("FAIL: false")
    } else {
        print("OK: false else, ")
    }
    if 2 > 1 => print("OK: 2 > 1, ")
    if 1 > 1 => panic("FAIL: 1 > 1")
    if 2 >= 2 => print("OK: 2 >= 2, ")
    if 1 >= 2 => panic("FAIL: 1 >= 2")
    if 2 == 2 => print("OK: 2 == 2, ")
    if 1 == 2 => panic("FAIL: 1 == 2")
    if 1 != 2 => print("OK: 1 != 2, ")
    if 1 != 1 => panic("FAIL: 1 != 1")
    if 1 < 2 => print("OK: 1 < 2, ")
    if 2 < 1 => panic("FAIL: 2 < 1")
    if 1 <= 2 => print("OK: 1 <= 2, ")
    if 2 <= 1 => panic("FAIL: 2 <= 1")
    if 1 == 2 or 2 == 2 => print("OK: 1 == 2 or 2 == 2, ")
    if 1 == 2 or 2 == 3 => print("FAIL: 1 == 2 or 2 == 3")
    if 1 == 1 and 2 == 2 => print("OK: 1 == 1 and 2 == 2, ")
    if 1 == 2 and 2 == 2 => panic("FAIL: 1 == 2 and 2 == 2")
    if not false => print("OK: not false, ")
    if not true => panic("FAIL: not true")
    -- Nested if expressions.
    if false => print("FAIL: nested")
    else => if true => if true => print("OK: nested")
    print(", ")
    print(nested_if_result(true))
    print(", ")
    print(nested_if_result(false))
}
