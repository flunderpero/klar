-- expect.stdout {
-- OK: true then, OK: false else, OK: 2 > 1, OK: 2 >= 2, OK: 2 == 2, OK: 1 != 2, OK: 1 < 2, OK: 1 <= 2, OK: 1 == 2 or 2 == 2, OK: 1 == 1 and 2 == 2, OK: not false, 
-- } expect.stdout
-- expect.exit_code: 0

fn main() {
    if true => print("OK: true then, ")
    if false {
        panic("FAIL: false")
    } else {
        print("OK: false else, ")
    }
    if 2 > 1 => print("OK: 2 > 1, ")
    if 1 > 1 => panic("FAIL: 1 > 1")
    if 2 >= 2 => print("OK: 2 >= 2, ")
    if 1 >= 2 => panic("FAIL: 1 >= 2")
    if 2 == 2 => print("OK: 2 == 2, ")
    if 1 == 2 => panic("FAIL: 1 == 2")
    if 1 != 2 => print("OK: 1 != 2, ")
    if 1 != 1 => panic("FAIL: 1 != 1")
    if 1 < 2 => print("OK: 1 < 2, ")
    if 2 < 1 => panic("FAIL: 2 < 1")
    if 1 <= 2 => print("OK: 1 <= 2, ")
    if 2 <= 1 => panic("FAIL: 2 <= 1")
    if 1 == 2 or 2 == 2 => print("OK: 1 == 2 or 2 == 2, ")
    if 1 == 2 or 2 == 3 => print("FAIL: 1 == 2 or 2 == 3")
    if 1 == 1 and 2 == 2 => print("OK: 1 == 1 and 2 == 2, ")
    if 1 == 2 and 2 == 2 => panic("FAIL: 1 == 2 and 2 == 2")
    if not false => print("OK: not false, ")
    if not true => panic("FAIL: not true")
}
