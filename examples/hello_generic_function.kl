fn return_it<T>(val T) T {
    val
}

fn return_it_again<U>(val U) U {
    return_it<U>(val)
}

fn apply_and_return<U, T>(val U, f (fn(U) T)) T {
    f(val)
}

-- Make sure type parameter names and function types (`f fn(U) T`)
-- each are local to the function definition. 
fn apply_and_return2<U, T>(val U, f (fn(U) T)) T {
    f(val)
}

fn return_first<K, V>(first K, second V) K {
    first
}

fn return_second<K, V>(first K, second V) V {
    second
}

fn str_to_int(in Str) Int => 1234567890

struct Planet {
    name Str
}

impl Planet {
    fn static<T>(val T) T {
        val
    }

    fn method<T>(self, val T) T {
        val
    }
}

fn main() {
    print(return_it<Str>("Yes"))
    print(return_it_again<Str>(" again "))
    print_int(return_it<Int>(4))
    print_int(return_it_again<Int>(2))
    print(return_first<Str, Int>(" multiple ", 42))
    print_int(return_second<Str, Int>(" multiple", 42))
    print(Planet.static<Str>(" static "))
    let p = Planet(name="Earth")
    print(return_it<Planet>(p).name)
    print(p.method<Str>(" and method "))
    print_int(apply_and_return<Str, Int>("Hello", str_to_int))
    print_int(apply_and_return2<Str, Int>("Hello", str_to_int))
    let var = return_it<Str>
    print(var(" from variable with type args "))
    -- Type inference
    -- print(return_it(" inferred"))
    -- print(return_second(42, " again"))
}
