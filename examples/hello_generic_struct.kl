struct Single<T> {
    bool Bool  -- We add this field, so we can test that struct layout is correct in the IR and ASM.
    value T
}

impl Single {
    fn return_value(self) T => self.value

    fn generic<U>(self, val U) U => val
}

fn main() {
    let b = Single<Bool>(false, value=true)
    print_bool(b.value)
    print(" ")
    print_bool(b.return_value())
    print(" ")
    print_bool(b.generic<Bool>(false))
    print(", ")

    let s = Single<Str>(false, value="Hello")
    print(s.value)
    print(" ")
    print(s.return_value())
    print(" ")
    print_int(s.generic<Int>(42))
    print(", ")

    let i = Single<Int>(false, value=42)
    print_int(i.value)
    print(" ")
    print_int(i.return_value())
    print(" ")
    print(i.generic<Str>("Hello"))
}
