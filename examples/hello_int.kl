-- Test that we can use int literals in variable definitions with explicit type.
fn variable_definitions() {
    print(" variable definitions: ")
    let i8 I8 = 127
    print_int(i8)
    print(", ")
    let i16 I16 = 32767
    print_int(i16)
    print(", ")
    let i32 I32 = 2147483647
    print_int(i32)
    print(", ")
    let i64 I64 = 9223372036854775807
    print_int(i64)
}

-- Test that we can use int literals of a specific type.
fn binary_expressions() {
    print(" binary expressions: ")
    let i8 I8 = 120
    print("i8: ")
    print_int(i8 + 8)
    print(", ")
    print_int(i8 - 127)
    print(", ")
    print_int(i8 * 2)
    print(", ")
    print_int(i8 / 2)
    print(", ")
    print_bool(i8 > 127)
    let i16 I16 = 32000
    print(", i16: ")
    print_int(i16 + 768)
    print(", ")
    print_int(i16 - 32767)
    print(", ")
    print_int(i16 * 2)
    print(", ")
    print_int(i16 / 2)
    print(", ")
    print_bool(i16 > 32767)
    let i32 I32 = 2147483640
    print(", i32: ")
    print_int(i32 + 8)
    print(", ")
    print_int(i32 - 2147483647)
    print(", ")
    print_int(i32 * 2)
    print(", ")
    print_int(i32 / 2)
    print(", ")
    print_bool(i32 > 2147483647)
    let i64 I64 = 9223372036854775800
    print(", i64: ")
    print_int(i64 + 8)
    print(", ")
    print_int(i64 - 9223372036854775807)
    print(", ")
    print_int(i64 * 2)
    print(", ")
    print_int(i64 / 2)
    print(", ")
    print_bool(i64 > 9223372036854775807)
}

-- Test that larger int types are assignable from smaller ones.
fn different_int_sizes() {
    print(" different_int_sizes: ")
    let i8 I8 = 5
    let i32 I32 = i8
    print_int(i32)
    print(", ")
    let i16 I16 = 37
    print_int(i16 + i8)
}

fn negative_numbers() {
    print(" negative numbers: ")
    let a I8 = -12
    print_int(a)
    print(", ")
    let b = -30
    print_int(b)
    print(", ")
    print_int(b + a)
    print(", ")
    print_int(100 + -58)
}

fn conversions() {
    print_int(257.to_u8())
    print(", ")
    print_int(65538.to_u16())
    print(", ")
    print_int(4294967299.to_u32())
    print(", ")
    let x = 9223372036854775807.to_u64()
    print_uint(x)
    print(", ")
    print_int(129.to_i8())
    print(", ")
    print_int(32769.to_i16())
    print(", ")
    print_int(2147483649.to_i32())
    print(", ")
    let b I8 = -1
    print_int(b.to_u8())
    print(", ")
    print_int(b.to_u16())
    print(", ")
    print_int(b.to_u32())
    print(", ")
    print_uint(b.to_u64())
    print(", ")
    print_int(b.to_i16())
    print(", ")
    print_int(b.to_i32())
    print(", ")
    print_int(b.to_i64())
    print(", ")
    print_int(b.to_int())
}

fn main() {
    variable_definitions()
    binary_expressions()
    different_int_sizes()
    negative_numbers()
    conversions()
}
