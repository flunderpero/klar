-- expect.stdout {
-- abc
-- } expect.stdout
-- expect.exit_code: 0

struct Triple<T> {
    a T
    b T
    c T
}

struct TripleIter<I> {
    value Triple<I>
    mut index Int
}

impl Iter<I> for TripleIter {
    fn next(mut self) I | None {
        self.index = self.index + 1
        match self.index {
            case 1 => self.value.a
            case 2 => self.value.b
            case 3 => self.value.c
            case _ => None
        }
    }
}

impl ToIter<T> for Triple {
    fn to_iter(self) TripleIter<T> => TripleIter<T>(self, 0)
}

fn main() {
    let triple = Triple("a", "b", "c")
    let iter = triple.to_iter()
    loop {
        match iter.next() {
            case Str as s => print(s)
            case None => break
        }
    }
}
