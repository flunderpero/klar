-- expect.stdout {
-- Hello, RGB(10, 20, 255), i + 1 == 1, 2, i + 1 in 3..5, 7, 127 is any other int, Hello, world!Ax?
-- } expect.stdout
-- expect.exit_code: 0

union UnionType = Str | .RGB(Int, Int, Int)

fn match_union_type(v UnionType) {
    match v {
        case Str as s => print(s)
        case .RGB as rgb {
            print("RGB(")
            print_int(rgb.0)
            print(", ")
            print_int(rgb.1)
            print(", ")
            print_int(rgb.2)
            print(")")
        } 
    }
    print(", ")
}

fn match_int_plus_one(i I8) {
    match i + 1 {  -- `+ 1` so we don't always just match on ident expressions.
        case 1 => print("i + 1 == 1")
        case 2 as a => print_int(a)
        case 3..5 => print("i + 1 in 3..5")
        case 6..<8 as b => print_int(b)
        case _ as c { 
            print_int(c)
            print(" is any other int")
        }
    }
    print(", ")
}

fn match_str(s Str) Str {
    match s {
        case "world" => "Hello, "
        case "Hello, " => "world"
        case _ as other => other
    }
}

fn match_char(c Char) Char {
    match c {
        case 'a' => 'A'
        case 'b' .. 'z' as x => x 
        case _ => '?'
    }
}

fn main() {
    let str UnionType = "Hello"
    let blue = UnionType.RGB(10, 20, 255)
    match_union_type(str)
    match_union_type(blue)
    match_int_plus_one(0)
    match_int_plus_one(1)
    match_int_plus_one(4)
    match_int_plus_one(6)
    match_int_plus_one(126)
    print(match_str("world"))
    print(match_str("Hello, "))
    print(match_str("!"))
    print_char(match_char('a'))
    print_char(match_char('x'))
    print_char(match_char('X'))
}
