-- expect.stdout {
-- 8, 1, 2, 4, 8, 1, 8, 8, 1, 8
-- } expect.stdout
-- expect.exit_code: 0

struct Pair<K, V> {
    key K
    value V
}

impl Pair {
    fn static_size() Int => sizeof<K>()
    fn key_size(self) Int => sizeof<K>()
}

fn generic<T>() Int => sizeof<T>()

fn main() {
    print_int(sizeof<Str>())
    print(", ")
    print_int(sizeof<I8>())
    print(", ")
    print_int(sizeof<I16>())
    print(", ")
    print_int(sizeof<I32>())
    print(", ")
    print_int(sizeof<I64>())
    print(", ")
    print_int(generic<Bool>())
    print(", ")
    print_int(generic<Int>())
    print(", ")
    print_int(sizeof<Pair<Bool, Bool>>())
    print(", ")
    let p = Pair<Bool, Int>(true, 1)
    print_int(p.key_size())
    print(", ")
    print_int(Pair<Str, Str>.static_size())
}
