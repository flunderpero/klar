-- All core types that are always available.

-- [[ Functions ]]

fn panic(msg Str) Never {
    print(msg)
    internal_exit(1)
}

fn print<T impl ToStr>(s T) {
    internal_print(s.to_str())
}

fn internal_memcpy(dst RawPtr, src RawPtr, len Int) {
    mut i = 0
    mut s = src
    mut d = dst
    loop {
        if i == len {
            break
        }
        i = i + 1
        let b = internal_read_ptr<U8>(s)
        internal_write_ptr<U8>(d, b)
        s = s + 1
        d = d + 1
    }
}

-- [[ Traits ]]

trait ToStr {
    fn to_str(self) Str
}

-- [[ Basic Types ]]

-- [[ Array ]]

-- The `InternalArray` maps to the array type in Klar.
-- Its structure is as follows:
-- struct InternalArray {
--      capacity_ Int
--      len_      Int
--      data_     RawPtr
-- }

impl InternalArray {
    fn capacity(self) Int => self.capacity_

    fn len(self) Int => self.len_

    fn internal_index_ptr(self, index Int) Int {
        let i = if index < 0 => self.len_ + index else => index
        if i <= 0 or i >= self.len_ {
            panic("Index out of bounds")
        }
        self.data_ + i * sizeof<T>()
    }

    fn internal_get(self, index Int) T {
        internal_read_ptr<T>(self.internal_index_ptr(index))
    } 

    fn internal_set(self, index Int, val T) {
        internal_write_ptr<T>(self.internal_index_ptr(index), val)
    }
}

-- [[ Str ]]

-- This is the built-in Str declaration:
-- struct Str {
--     len_   Int
--     bytes_ RawPtr
-- }

impl Str {
    fn concat(self, s Str) Str {
        let len = self.len_ + s.len_
        let bytes = internal_malloc(len)
        internal_memcpy(bytes, self.bytes_, self.len_)
        internal_memcpy(bytes + self.len_, s.bytes_, s.len_)
        Str(len, bytes)
    }

    fn eq(self, s Str) Bool {
        if self.len_ != s.len_ {
            return false
        }
        let len = self.len_
        mut i = 0
        loop {
            if i == len {
                break
            }
            let a = internal_read_ptr<U8>(self.bytes_ + i)
            let b = internal_read_ptr<U8>(s.bytes_ + i)
            if a != b {
                return false
            }
            i = i + 1
        }
        true
    }

    fn len(self) Int {
       self.len_ 
    }
}

impl ToStr for Str {
    fn to_str(self) Str => self 
}

-- [[ Int Types ]]

impl I8 {
    fn to_u8(self) U8 => internal_cast<I8, U8>(self)
    fn to_u16(self) U16 => internal_cast<I8, U16>(self)
    fn to_u32(self) U32 => internal_cast<I8, U32>(self)
    fn to_u64(self) U64 => internal_cast<I8, U64>(self)
    fn to_i16(self) I16 => internal_cast<I8, I16>(self)
    fn to_i32(self) I32 => internal_cast<I8, I32>(self)
    fn to_i64(self) I64 => internal_cast<I8, I64>(self)
    fn to_int(self) Int => internal_cast<I8, Int>(self)
}

